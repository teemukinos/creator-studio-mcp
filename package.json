{
  "name": "creator-studio-mcp",
  "version": "0.7.1",
  "description": "Unofficial MCP server for Apple Creator Studio apps on macOS (not affiliated with Apple): Pixelmator Pro, Keynote, Pages, Numbers, Compressor, Final Cut Pro and more",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teemukinos/creator-studio-mcp.git"
  },
  "homepage": "https://github.com/teemukinos/creator-studio-mcp#readme",
  "bugs": {
    "url": "https://github.com/teemukinos/creator-studio-mcp/issues"
  },
  "bin": {
    "creator-studio-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "find dist -type f -exec chmod 644 {} + && chmod 755 dist/index.js && chmod 644 package.json README.md LICENSE",
    "start": "node dist/index.js",
    "test": "node --test --import tsx test/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
