{
  "name": "creator-studio-mcp",
  "version": "0.7.1",
  "description": "MCP server for Apple Creator Studio apps on macOS: Pixelmator Pro, Keynote, Pages, Numbers, Compressor and Final Cut Pro",
  "type": "module",
  "license": "MIT",
  "bin": {
    "creator-studio-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
